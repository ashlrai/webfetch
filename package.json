{
  "name": "web-fetcher-mcp",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "workspaces": ["packages/*", "cloud/workers"],
  "scripts": {
    "typecheck": "bun run typecheck:packages && bun run --cwd cloud/workers typecheck",
    "typecheck:packages": "tsc -p tsconfig.packages.json",
    "test": "bun test",
    "demo": "bun run packages/core/src/demo.ts",
    "mcp": "bun run packages/mcp/src/index.ts",
    "lint": "biome check .",
    "lint:ci": "biome check tests/server.test.ts cloud/workers"
  },
  "dependencies": {
    "webfetch-core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
